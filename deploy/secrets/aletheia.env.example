# Copy to aletheia.env and fill in. Never commit the filled copy.
# Run: docker run --env-file deploy/secrets/aletheia.env ...
#
# Provider: none | gemini | openai | groq | anthropic | ollama | openai_compatible
# "none" is the default and keeps the Studio on heuristics only (air-gap safe).
ALETHEIA_LLM_PROVIDER=gemini
ALETHEIA_LLM_MODEL=gemma-4-31b-it
ALETHEIA_LLM_API_KEY=
# ALETHEIA_LLM_API_KEY_FILE=/run/secrets/llm_key   # preferred over the inline key
# ALETHEIA_LLM_BASE_URL=                           # override; required for openai_compatible
ALETHEIA_LLM_SEND_SAMPLES=masked                   # masked | none | raw (raw = self-hosted only)
ALETHEIA_AIRGAP=false                              # true refuses all cloud providers
# ALETHEIA_SECRET=                                 # AES-GCM key for settings stored via the UI
