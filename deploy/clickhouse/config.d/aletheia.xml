<clickhouse>
    <!-- No outbound calls (spec §13.6). -->
    <send_crash_reports>
        <enabled>false</enabled>
        <send_logical_errors>false</send_logical_errors>
    </send_crash_reports>

    <!-- Prometheus scrape endpoint for the pipeline dashboards. -->
    <prometheus>
        <endpoint>/metrics</endpoint>
        <port>9363</port>
        <metrics>true</metrics>
        <events>true</events>
        <asynchronous_metrics>true</asynchronous_metrics>
        <status_info>true</status_info>
    </prometheus>

    <!-- Benchmarks read compressed/uncompressed bytes from system.parts; keep the
         merge behaviour predictable so the storage numbers are reproducible. -->
    <merge_tree>
        <merge_max_block_size>8192</merge_max_block_size>
    </merge_tree>

    <logger>
        <level>warning</level>
    </logger>
</clickhouse>
