{
  "uid": "aletheia-logs",
  "title": "Aletheia — Logs (Loki)",
  "description": "Normalized events and raw lines in Loki. Deep link: /d/aletheia-logs/aletheia-logs?var-event_uid=<uid> (CONTRACTS §13.5).",
  "tags": [
    "aletheia",
    "logs"
  ],
  "timezone": "browser",
  "editable": false,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "graphTooltip": 1,
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "aletheia"
      ],
      "asDropdown": false,
      "title": "Aletheia",
      "includeVars": false,
      "keepTime": true,
      "icon": "external link",
      "targetBlank": false
    }
  ],
  "templating": {
    "list": [
      {
        "name": "event_uid",
        "label": "event_uid",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        },
        "options": []
      },
      {
        "name": "vendor",
        "label": "Vendor",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "aletheia-loki"
        },
        "query": {
          "type": 1,
          "label": "vendor",
          "stream": "",
          "refId": "LokiVariableQueryEditor-VariableQuery"
        },
        "definition": "label_values(vendor)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".+",
        "sort": 1,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": []
      },
      {
        "name": "source_id",
        "label": "Source",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "aletheia-loki"
        },
        "query": {
          "type": 1,
          "label": "source_id",
          "stream": "{vendor=~\"$vendor\"}",
          "refId": "LokiVariableQueryEditor-VariableQuery"
        },
        "definition": "label_values({vendor=~\"$vendor\"}, source_id)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".+",
        "sort": 1,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": []
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Normalized events — Redpanda `normalized` → Vector → Loki",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Log volume by vendor",
      "description": "count_over_time over the five-label streams, stacked by vendor.",
      "datasource": {
        "type": "loki",
        "uid": "aletheia-loki"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "lineWidth": 1,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "aletheia-loki"
          },
          "expr": "sum by (vendor) (count_over_time({vendor=~\"$vendor\", source_id=~\"$source_id\"} [$__auto]))",
          "legendFormat": "{{vendor}}",
          "queryType": "range"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Log volume by parse status",
      "description": "full / partial / raw_only. raw_only is stored verbatim, never dropped.",
      "datasource": {
        "type": "loki",
        "uid": "aletheia-loki"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "lineWidth": 1,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "full"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "partial"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "yellow"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "raw_only"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "aletheia-loki"
          },
          "expr": "sum by (parse_status) (count_over_time({vendor=~\"$vendor\", source_id=~\"$source_id\"} [$__auto]))",
          "legendFormat": "{{parse_status}}",
          "queryType": "range"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "raw_only share (quarantine signal)",
      "description": "Fraction of events no pack template matched. A jump usually means format drift.",
      "datasource": {
        "type": "loki",
        "uid": "aletheia-loki"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 20,
            "lineWidth": 1,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "aletheia-loki"
          },
          "expr": "sum(count_over_time({vendor=~\"$vendor\", source_id=~\"$source_id\", parse_status=\"raw_only\"} [5m])) / sum(count_over_time({vendor=~\"$vendor\", source_id=~\"$source_id\"} [5m]))",
          "legendFormat": "raw_only share",
          "queryType": "range"
        }
      ]
    },
    {
      "id": 5,
      "type": "bargauge",
      "title": "Top sources (selected range)",
      "description": "Normalized events per source_id over the dashboard time range.",
      "datasource": {
        "type": "loki",
        "uid": "aletheia-loki"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "valueMode": "color",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "aletheia-loki"
          },
          "expr": "topk(10, sum by (source_id) (count_over_time({vendor=~\"$vendor\", source_id=~\"$source_id\"} [$__range])))",
          "legendFormat": "{{source_id}}",
          "queryType": "instant"
        }
      ]
    },
    {
      "id": 10,
      "type": "row",
      "title": "Raw ingest — Studio raw store (labels source, severity, format)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 17
      },
      "panels": []
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Raw lines by source",
      "description": "Verbatim lines Studio pushed before any parsing.",
      "datasource": {
        "type": "loki",
        "uid": "aletheia-loki"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 18
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "lineWidth": 1,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "aletheia-loki"
          },
          "expr": "sum by (source) (count_over_time({source=~\"$source_id\"} [$__auto]))",
          "legendFormat": "{{source}}",
          "queryType": "range"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Raw lines by severity",
      "description": "Cheap pre-parse severity guess; the parsed severity lives on the normalized event.",
      "datasource": {
        "type": "loki",
        "uid": "aletheia-loki"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 18
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "lineWidth": 1,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "risk"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "warn"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "notice"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "info"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "aletheia-loki"
          },
          "expr": "sum by (severity) (count_over_time({source=~\"$source_id\"} [$__auto]))",
          "legendFormat": "{{severity}}",
          "queryType": "range"
        }
      ]
    },
    {
      "id": 20,
      "type": "row",
      "title": "Lines",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 26
      },
      "panels": []
    },
    {
      "id": 21,
      "type": "logs",
      "title": "Normalized events",
      "description": "Filtered by vendor, source and the event_uid box (structured metadata; empty matches all).",
      "datasource": {
        "type": "loki",
        "uid": "aletheia-loki"
      },
      "gridPos": {
        "h": 14,
        "w": 24,
        "x": 0,
        "y": 27
      },
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "aletheia-loki"
          },
          "expr": "{vendor=~\"$vendor\", source_id=~\"$source_id\"} | event_uid=~\"${event_uid}.*\"",
          "queryType": "range"
        }
      ]
    },
    {
      "id": 22,
      "type": "logs",
      "title": "Raw lines",
      "description": "Exactly as received; sha256 of the bytes is in structured metadata.",
      "datasource": {
        "type": "loki",
        "uid": "aletheia-loki"
      },
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 41
      },
      "options": {
        "showTime": true,
        "showLabels": true,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "aletheia-loki"
          },
          "expr": "{source=~\"$source_id\"}",
          "queryType": "range"
        }
      ]
    }
  ]
}
