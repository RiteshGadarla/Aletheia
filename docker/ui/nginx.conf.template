# Rendered by the nginx image's envsubst at start; ${...} come from the environment.
# The stack's only HTTP entry point: UI at /, Studio at /api/, Grafana at /grafana/.

# Grafana Live is a websocket; plain requests must still send "Connection: close".
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    # Relative Location headers, so a remapped host port is never redirected back to 8080.
    absolute_redirect off;

    # No third-party origins: everything the UI needs is bundled (spec §13.6).
    add_header Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self'; frame-src 'self'" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options SAMEORIGIN always;
    add_header Referrer-Policy no-referrer always;

    # Readiness of the whole stack is the Studio's answer; nginx only proxies it.
    location = /healthz {
        proxy_pass ${ALETHEIA_STUDIO_UPSTREAM}/healthz;
        proxy_connect_timeout 2s;
        proxy_read_timeout 5s;
        access_log off;
    }

    location /api/ {
        proxy_pass ${ALETHEIA_STUDIO_UPSTREAM}/api/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 300s;        # replay diff and bench runs are slow
        proxy_buffering off;
    }

    # Grafana runs with serve_from_sub_path, so the /grafana/ prefix is passed through, not stripped.
    # Its own add_header lines stop the UI's strict CSP (no inline script) being inherited,
    # which would leave Grafana a blank page.
    location = /grafana { return 301 /grafana/; }
    location /grafana/ {
        proxy_pass ${ALETHEIA_GRAFANA_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;     # Grafana Live websocket
        proxy_set_header Connection $connection_upgrade;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy no-referrer always;
    }

    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # SPA routes (/demo, /studio, /lineage, ...) resolve to index.html.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
