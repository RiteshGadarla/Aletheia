# Pinned upstream versions (spec §13.2). Single source of truth for compose + buildx.
# Change here only; every Dockerfile and docker-compose.yml reads these.

ALETHEIA_VERSION=1.0.0
ALETHEIA_REGISTRY=docker.io/ritesh2006

# Upstream components
VECTOR_VERSION=0.44.0
REDPANDA_VERSION=v24.3.6
CLICKHOUSE_VERSION=24.8.14.39
POSTGRES_VERSION=16.6
LOKI_VERSION=3.3.2
GRAFANA_VERSION=11.4.0
PROMETHEUS_VERSION=v3.1.0

# Builders / bases
GO_VERSION=1.23
NODE_VERSION=22
PYTHON_VERSION=3.12
DEBIAN_SUITE=bookworm
NGINX_VERSION=1.27-alpine
S6_OVERLAY_VERSION=3.2.0.2

# Grafana plugins (bundled offline, never downloaded at run time)
GRAFANA_CLICKHOUSE_PLUGIN_VERSION=4.5.1
