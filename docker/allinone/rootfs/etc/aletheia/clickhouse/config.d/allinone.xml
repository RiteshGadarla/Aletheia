<!-- All-in-one overrides. The image ships ClickHouse's own stock config.xml and users.xml
     (copied from the upstream image) so its tested defaults apply; this fragment only moves
     state off the image and onto /data, the single mutable tree.

     Loopback only: the Dockerfile deletes the stock docker_related_config.xml (0.0.0.0 and ::),
     so ClickHouse is reachable just from inside the container. Nothing publishes 8123/9000.

     The access/ override matters more than it looks: init-ch-schema.sh runs CREATE USER for
     the read-only demo account, and SQL-created users are written to this directory. Left at
     the stock /var/lib/clickhouse/access/ it would write into the container layer instead of
     the volume and be lost on every restart. -->
<clickhouse>
    <listen_host>127.0.0.1</listen_host>

    <path>/data/clickhouse/</path>
    <tmp_path>/data/clickhouse/tmp/</tmp_path>
    <user_files_path>/data/clickhouse/user_files/</user_files_path>
    <format_schema_path>/data/clickhouse/format_schemas/</format_schema_path>

    <user_directories>
        <users_xml>
            <path>users.xml</path>
        </users_xml>
        <local_directory>
            <path>/data/clickhouse/access/</path>
        </local_directory>
    </user_directories>

    <logger>
        <log>/data/logs/clickhouse-server.log</log>
        <errorlog>/data/logs/clickhouse-server.err.log</errorlog>
    </logger>
</clickhouse>
