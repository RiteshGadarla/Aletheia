#!/command/with-contenv bash
# Onboarding Studio + registry API. Never re-implements matching: it shells out
# to the engine CLI (CONTRACTS §8).
set -eu
exec 2>&1
/opt/aletheia/init/wait-for.sh tcp 127.0.0.1:5432 120
/opt/aletheia/init/wait-for.sh tcp 127.0.0.1:8123 120
export ALETHEIA_SECRET="$(cat /data/secret 2>/dev/null || true)"
cd /app
exec s6-setuidgid aletheia /venv/bin/uvicorn studio.api.main:app \
  --host 127.0.0.1 --port 8081 --no-server-header
