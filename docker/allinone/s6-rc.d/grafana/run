#!/command/with-contenv bash
# Dashboards over ClickHouse, Loki and Prometheus. Telemetry already off via env.
set -eu
exec 2>&1
/opt/aletheia/init/wait-for.sh tcp 127.0.0.1:9090 60
export GF_SECURITY_ADMIN_USER=admin
export GF_SECURITY_ADMIN_PASSWORD="${ALETHEIA_ADMIN_PASSWORD:-aletheia}"
export GF_PATHS_DATA=/data/grafana
export GF_PATHS_LOGS=/data/logs/grafana
export GF_PATHS_PLUGINS=/data/grafana/plugins
export GF_PATHS_PROVISIONING=/etc/aletheia/grafana/provisioning
export ALETHEIA_CH_PASSWORD="${ALETHEIA_CH_PASSWORD:-aletheia}"
exec s6-setuidgid aletheia /usr/share/grafana/bin/grafana server \
  --homepath=/usr/share/grafana \
  --config=/etc/aletheia/grafana/grafana.ini
