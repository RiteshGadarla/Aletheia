#!/command/with-contenv bash
# MinIO on 9100: ClickHouse already owns 9000 inside this container.
set -eu
exec 2>&1
export MINIO_ROOT_USER="${ALETHEIA_S3_ACCESS_KEY:-aletheia}"
export MINIO_ROOT_PASSWORD="${ALETHEIA_S3_SECRET_KEY:-aletheia-demo-secret}"
export MINIO_UPDATE=off
export MINIO_PROMETHEUS_AUTH_TYPE=public
exec s6-setuidgid aletheia /usr/local/bin/minio server /data/minio \
  --address 127.0.0.1:9100 --console-address 127.0.0.1:9101
