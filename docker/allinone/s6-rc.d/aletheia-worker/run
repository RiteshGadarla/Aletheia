#!/command/with-contenv bash
# ALETHEIA_WORKERS processes in one consumer group; Redpanda rebalances partitions.
set -eu
exec 2>&1
/opt/aletheia/init/wait-for.sh tcp 127.0.0.1:9092 120
/opt/aletheia/init/wait-for.sh tcp 127.0.0.1:9000 120
N="${ALETHEIA_WORKERS:-2}"
pids=()
for i in $(seq 1 "$N"); do
  ALETHEIA_METRICS_ADDR="127.0.0.1:$((9107 + i))" \
  ALETHEIA_WORKER_ID="w${i}" \
  s6-setuidgid aletheia /usr/local/bin/worker &
  pids+=($!)
done
# Any worker dying takes the group down so s6 restarts the whole set cleanly.
trap 'kill "${pids[@]}" 2>/dev/null || true' TERM INT
wait -n "${pids[@]}"
kill "${pids[@]}" 2>/dev/null || true
exit 1
