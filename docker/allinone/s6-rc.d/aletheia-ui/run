#!/command/with-contenv bash
# nginx serves the bundled UI on 6156 and proxies /api and /healthz.
set -eu
exec 2>&1
# Wait for the readiness aggregator (8088), not the Studio directly: nginx proxies /healthz
# there, and the aggregator already probes the Studio on 8081 along with everything else.
/opt/aletheia/init/wait-for.sh tcp 127.0.0.1:8088 60
# Absolute path on purpose: nginx is in /usr/sbin, and a PATH regression here silently
# takes the entire frontend down while every other service still reports fine.
exec /usr/sbin/nginx -c /etc/nginx/nginx.conf -g 'daemon off;'
