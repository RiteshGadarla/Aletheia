#!/command/with-contenv bash
# Redpanda: raw bytes are replicated to disk before any parsing starts.
set -eu
exec 2>&1
# rpk translates these into the raw binary's seastar flags; the raw binary itself has no
# "--check"/"--smp"/"--memory" options of its own (only "rpk redpanda start" does).
exec s6-setuidgid aletheia /usr/local/bin/rpk redpanda start \
  --config /etc/aletheia/redpanda/redpanda.yaml \
  --smp "${ALETHEIA_RP_CORES:-1}" \
  --memory "${ALETHEIA_RP_MEMORY:-1G}" \
  --overprovisioned \
  --check=false
