{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Studio API (FastAPI Backend)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "backend.studio.main:app",
        "--reload",
        "--host",
        "0.0.0.0",
        "--port",
        "8081"
      ],
      "jinja": true,
      "env": {
        "ALETHEIA_MODE": "lite",
        "ALETHEIA_PG_DSN": "postgres://aletheia:aletheia@127.0.0.1:5432/aletheia",
        "ALETHEIA_BUS_BROKERS": "127.0.0.1:9092"
      }
    },
    {
      "name": "Verify Parser Packs",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/backend/packs/verify_packs.py",
      "console": "integratedTerminal"
    }
  ]
}
